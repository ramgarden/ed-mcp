# Copy to .env and fill in. Never commit .env.
# Optional: Inara API key from https://inara.cz/settings-api/ (needed for inara_* tools)
INARA_API_KEY=
# Optional: override Elite Dangerous journal folder (default: %USERPROFILE%\Saved Games\Frontier Developments\Elite Dangerous)
ED_JOURNAL_DIR=
# Optional: EDSM API key (only needed for commander-specific EDSM endpoints; public sphere/system lookups work without)
EDSM_API_KEY=
